{
  "name": "base",
  "version": "5.0.1",
  "main": "index.html",
  "repository": {},
  "dependencies": {
    "basecoat-css": "0.3.11",
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./tailwind-basecoat.css -o ./resource/app/compiled.css",
    "build": "npm run build:css && npx tsc",
    "watch": "npx tsc --watch --preserveWatchOutput",
    "serve": "npm run build:css && npx tsc && npx http-server .",
    "playwright:install": "npx playwright install",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:single": "npx playwright test tests/playwright/example.spec.js"
  }
}
